# ── X / Twitter ──────────────────────────────────────────────────────────────
# Get from: https://developer.twitter.com/en/portal/dashboard
# Used for: fetching real trending posts (mock data used without it)
TWITTER_BEARER_TOKEN=

# ── Video Generation ──────────────────────────────────────────────────────────
# D-ID: https://studio.d-id.com → API section
# Used for: AI presenter video generation
DID_API_KEY=

# Runway ML: https://runwayml.com → Settings → API Keys
# Used for: AI video generation (fallback if D-ID not set)
RUNWAY_API_KEY=

# ── TikTok Auto-Upload ────────────────────────────────────────────────────────
# Get from: https://developers.tiktok.com → OAuth 2.0 flow
# Scopes needed: video.upload, video.publish
# Used for: auto-publishing videos to TikTok
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
