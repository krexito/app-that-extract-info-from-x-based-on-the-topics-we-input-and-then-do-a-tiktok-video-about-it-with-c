# ── X / Twitter ──────────────────────────────────────────────────────────────
# Get from: https://developer.twitter.com/en/portal/dashboard
# Used for: fetching real trending posts (Reddit used as fallback, mock data if both fail)
TWITTER_BEARER_TOKEN=

# ── FREE Alternatives for Data Sources ───────────────────────────────────────
# Reddit: NO KEY NEEDED — used automatically as fallback when Twitter key is absent
# The app calls https://www.reddit.com/search.json (public API, no auth required)

# ── Video Generation ──────────────────────────────────────────────────────────

# --- FREE options (pick one) ---

# Hugging Face (FREE tier — 1000 req/day)
# Sign up at: https://huggingface.co → Settings → Access Tokens → New token (read)
# Used for: AI text-to-video generation (damo-vilab/text-to-video-ms-1.7b model)
HUGGINGFACE_API_TOKEN=

# Pexels (FREE — 200 req/hour, no credit card)
# Sign up at: https://www.pexels.com/api/
# Used for: stock video background matching the topic (portrait/vertical for TikTok)
PEXELS_API_KEY=

# --- Paid options ---

# D-ID: https://studio.d-id.com → API section (20 free trial credits)
# Used for: AI presenter avatar video generation
DID_API_KEY=

# Runway ML: https://runwayml.com → Settings → API Keys (paid, ~$0.05/sec)
# Used for: AI video generation (fallback if D-ID not set)
RUNWAY_API_KEY=

# ── TikTok Auto-Upload ────────────────────────────────────────────────────────
# Get from: https://developers.tiktok.com → OAuth 2.0 flow
# Scopes needed: video.upload, video.publish
# Used for: auto-publishing videos to TikTok
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# ── Vercel Cron Scheduler ─────────────────────────────────────────────────────
# CRON_SECRET: random secret to protect the cron endpoint from unauthorized calls
# Generate one with: openssl rand -hex 32
# Set this in your Vercel dashboard → Settings → Environment Variables
CRON_SECRET=

# AUTO_TOPICS: comma-separated list of topics the cron job will track every hour
# Default (if not set): AI,crypto,gaming
# Example: "AI,crypto,gaming,tech,science"
AUTO_TOPICS=

# NEXT_PUBLIC_BASE_URL: your deployed app URL (used by cron to call its own API)
# Example: https://your-app.vercel.app
# On Vercel this is auto-set via VERCEL_URL — only needed for local testing
NEXT_PUBLIC_BASE_URL=
